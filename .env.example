GIN_PORT=8080

# Init super admin
INITIAL_SUPER_ADMIN_NAME=Arfan
INITIAL_SUPER_ADMIN_NUMBER=2173
INITIAL_SUPER_ADMIN_PHONE_NUMBER=6288899991111
INITIAL_SUPER_ADMIN_EMAIL=admin@credchain.com
INITIAL_SUPER_ADMIN_PRIVATE_KEY=0x...
INITIAL_SUPER_ADMIN_BIRTH_DATE=2003-07-21
INITIAL_SUPER_ADMIN_GENDER=male
INITIAL_SUPER_ADMIN_META=

# Wallet (must be exactly 32 ASCII characters for AES-256)
WALLET_ENCRYPTION_KEY=32byteencryptionkey123456789012a

# File at-rest encryption (must be exactly 32 ASCII characters for AES-256)
FILE_ENCRYPTION_KEY=32bytefileencryptionkey1234567a

# Credential files subdirectory under STORAGE_PATH (default: credentials)
# CREDENTIAL_FILE_STORAGE_PATH=credentials

# Solidity relateds
RPC_URL=http://localhost:8545
RELAYER_PRIVATE_KEY=0x...

# Hardhat wallet derivation (defaults to standard Hardhat mnemonic if unset)
# HARDHAT_MNEMONIC=test test test test test test test test test test test junk
AUTHORITY_CONTRACT=0x...
REGISTRY_CONTRACT=0x...

# Organization identity (displayed on credentials as "Issued by ...")
ISSUING_ORGANIZATION_NAME=

# JWTs
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_HOURS=168

# Postgres
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=credchain
POSTGRES_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# Postgres connection config
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5
DB_CONN_MAX_IDLE_TIME=1

# Mongo
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=root
MONGO_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@localhost:27017

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# Gin/CORS
# IMPORTANT: When AllowCredentials=true (cookie auth), do NOT use "*" for origins.
# Browsers reject Access-Control-Allow-Origin: * with credentials.
GIN_CORS_ALLOW_ORIGINS=http://localhost:5173
GIN_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
GIN_CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With
GIN_CORS_EXPOSE_HEADERS=Content-Length
GIN_CORS_ALLOW_CREDENTIALS=true
GIN_CORS_MAX_AGE=43200

# Cookie auth
# COOKIE_DOMAIN: leave empty for host-only cookie (recommended for same-origin)
# COOKIE_SECURE: must be true in production (HTTPS only)
# COOKIE_SAMESITE: strict (recommended) | lax | none (requires secure=true)
# COOKIE_ACCESS_PATH: path scope for access_token cookie (default /api)
# COOKIE_REFRESH_PATH: path scope for refresh_token cookie (default /api/auth)
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_ACCESS_PATH=/api
COOKIE_REFRESH_PATH=/api/auth

# Logger
LOG_LEVEL=info
LOG_OUTPUT=stdout

# I18n
I18N_LOCALES_DIR=./locales

# Python AI Service
PYTHON_AI_API_KEY=

# MongoDB / AI / River
MONGO_DATABASE=credchain
AI_VERIFICATION_CACHE_TTL_HOURS=24
RIVER_MAX_WORKERS=10

# Mail / SMTP (leave MAIL_HOST empty to disable email notifications)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@credchain.com
APP_BASE_URL=http://localhost:5173
